#!/bin/bash
# Run jnext with NextPi on its Raspberry Pi UART (UART 1). Run bin/setup-nextpi first.
#
#   bin/run-jnext                    jnext with the sandbox's NextPi on UART 1
#   bin/run-jnext --sdcard next.img  ...extra arguments go to jnext
#
# jnext starts QEMU itself (--pi-qemu) on this sandbox's prepared directory,
# wires the Pi's console to UART 1, and stops QEMU when it exits — so this is
# just `jnext --pi-qemu "$NEXTPI_HOME" "$@"` with the checks in front.
# NextPi takes ~1 minute to reach SUP>; then, at the NextZXOS prompt:
#   .pisend -q
#   .pisend -c nextpi-play_speech "Hello"
#
# Environment: JNEXT (default: jnext on PATH) — a build with --pi-qemu.
# Don't run bin/run-nextpi at the same time: both use dist/overlay.qcow2.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HOME_DIR="${NEXTPI_HOME:-$ROOT/dist}"
JNEXT="${JNEXT:-jnext}"

die() { echo "run-jnext: $*" >&2; exit 1; }

case "${1:-}" in
  -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

command -v "$JNEXT" >/dev/null || die "jnext not found (set JNEXT to the binary)"
[[ "$("$JNEXT" --help 2>&1 || true)" == *--pi-qemu* ]] \
  || die "$JNEXT has no --pi-qemu (it needs https://github.com/jorgegv/jnext/pull/310)"
for f in nextpi.img boot/kernel.img boot/bcm2708-rpi-zero.dtb; do
  [[ -e "$HOME_DIR/$f" ]] || die "$HOME_DIR/$f missing; run bin/setup-nextpi first"
done

exec "$JNEXT" --pi-qemu "$HOME_DIR" "$@"
